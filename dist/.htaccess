ErrorDocument 404 /404.html
RewriteEngine On
RedirectMatch 301 ^/pages/products/?$ /products/
RedirectMatch 301 ^/pages/about-us/?$ /about/
RedirectMatch 301 ^/pages/contact-us/?$ /contact/
RedirectMatch 301 ^/pages/faq/?$ /faqs/
RedirectMatch 301 ^/pages/oxytocin/?$ /products/oxytocin/
RedirectMatch 301 ^/pages/amrokort/?$ /products/amrokort/
